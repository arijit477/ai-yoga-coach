# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ASANA_BUCKET=asana-images

# OpenAI Realtime Configuration (Backend Only)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE_ALICE=sage
OPENAI_REALTIME_VOICE_KEVIN=ash
REALTIME_SESSION_TIMEOUT_SECONDS=20.0
REALTIME_RATE_LIMIT_PER_MINUTE=10
REALTIME_REQUIRE_AUTH=false

# ElevenLabs Voice Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_ALICE_VOICE_ID=alice_voice_id_here
ELEVENLABS_KEVIN_VOICE_ID=kevin_voice_id_here
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Allowed Origins / CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_ALL=false
